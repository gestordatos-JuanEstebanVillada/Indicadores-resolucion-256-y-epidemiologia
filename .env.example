SCSE_DB_USER=your_user
SCSE_DB_PASSWD=your_password
SCSE_DB_IP=localhost
SCSE_DB_PORT=1521
SCSE_DB_DATABASE=your_service_name

# Debe ser el mismo SECRET_KEY/ALGORITHM del backend Login/SSO, para poder
# validar los tokens JWT que ese backend emite.
SECRET_KEY=cambia-esta-clave-en-produccion-liga-2026
ALGORITHM=HS256

# Tableau Connected App (token lo genera el backend).
# Puedes definirlas aquí (TABLEAU_*) o en frontend/.env (VITE_TABLEAU_*).
TABLEAU_CLIENT_ID=
TABLEAU_SECRET_ID=
TABLEAU_SECRET_VALUE=
TABLEAU_USERNAME=
